# ============================================
# 后端环境变量模板
# 说明:Spring Boot 不直接读取 .env 文件,此文件仅列出启动前需要设置的环境变量。
# 请在启动前把它们导出为环境变量(见 README「启动步骤 → 后端」),
# 或在 IDE 的 Run Configuration 里配置。
# ============================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookstore_new
DB_USERNAME=root
DB_PASSWORD=your-database-password

# ---------- JWT(必填,至少 32 字符) ----------
JWT_SECRET=please-change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRATION=86400000

# ---------- CORS(允许访问的前端来源) ----------
CORS_ORIGINS=http://localhost:3000
